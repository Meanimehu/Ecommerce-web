# Copy to .env.local for local development. Never commit real values.
# local | staging | production
APP_ENV=local

# The backend API, read on the server only and never sent to the browser (Document 3, D3-03; Document 4, section 3).
# The backend's API routes live under /api/v1; its health check is /health.
BACKEND_URL=http://localhost:3000

# This site's own public address (origin checks, the sitemap). Local development runs on port 3001.
PUBLIC_SITE_URL=http://localhost:3001

# The public photo host (Document 3, D3-04). Pages may load images only from here.
# Locally this is Garage's website endpoint for the public bucket.
IMAGE_HOST=http://marketplace-public.web.localhost:9002

# The shared store (Document 4, D4-10): PostgreSQL, a database used ONLY by the frontend.
# Never point this at the backend's database.
STORE_DATABASE_URL=postgres://dhaaga_web:dhaaga_web_pass@localhost:5433/dhaaga_web_store

# How often each server re-checks the store guarantees, in seconds (Document 4, section 4: "at start-up and regularly").
STORE_CHECK_INTERVAL_SECONDS=60

# Secrets for Slice 1 (cookies and anti-forgery tokens). Use long random values: openssl rand -hex 32
COOKIE_SECRET=change-me-change-me-change-me-change-me-change-me-0123
CSRF_SECRET=change-me-change-me-change-me-change-me-change-me-4567
