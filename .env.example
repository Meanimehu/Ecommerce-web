# Copy to .env.local for local development. Never commit real values.
# local | staging | production
APP_ENV=local

# The backend API, read on the server only and never sent to the browser (Document 3, D3-03; Document 4, section 3).
# The backend's API routes live under /api/v1; its health check is /health.
BACKEND_URL=http://localhost:3000

# This site's own public address (origin checks, the sitemap). Locally always HTTPS on port 3001 (Document 7, section 17.1).
PUBLIC_SITE_URL=https://localhost:3001

# Header in which the hosting's front door gives the customer's address, for example x-forwarded-for. Leave empty
# locally. In staging and production set it for the host, and run the backend with TRUST_PROXY=true, so its
# per-address limits count each customer, not this server (Document 3, section 3; Document 4, section 4).
CLIENT_ADDRESS_HEADER=

# The public photo host (Document 3, D3-04). Pages may load images only from here.
# Locally this is Garage's website endpoint for the public bucket.
IMAGE_HOST=http://marketplace-public.web.localhost:9002

# The shared store (Document 4, D4-10): a PostgreSQL database used ONLY by the frontend. Locally it lives in the
# backend's PostgreSQL container as its own database, dhaaga_web_store (README). Never the backend's database itself:
# the store refuses to run there.
STORE_DATABASE_URL=postgres://marketplace:marketplace_pass@localhost:5432/dhaaga_web_store

# How often each server re-checks the store guarantees, in seconds (Document 4, section 4: "at start-up and regularly").
STORE_CHECK_INTERVAL_SECONDS=60

# Secrets, at least 32 characters each. Make your own: openssl rand -hex 32. Never commit real ones.
# COOKIE_SECRET signs the pending-add and after-login cookies; CSRF_SECRET makes anti-forgery tokens (D7-13).
COOKIE_SECRET=change-me-change-me-change-me-change-me-change-me-0123
CSRF_SECRET=change-me-change-me-change-me-change-me-change-me-4567
# STORE_SECRET: keyed hash of refresh tokens in the store and encryption of short-lived refresh results (Document 4,
# section 9). After changing it, put the old value in STORE_SECRET_PREVIOUS for 31 days so earlier markers still match.
STORE_SECRET=change-me-change-me-change-me-change-me-change-me-89ab
STORE_SECRET_PREVIOUS=
