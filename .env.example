# Copy to .env.local for local development. Never commit real values.
# local | staging | production
APP_ENV=local

# The backend API, read on the server only and never sent to the browser (Document 3, D3-03; Document 4, section 3).
# The backend's API routes live under /api/v1; its health check is /health.
BACKEND_URL=http://localhost:3000

# This site's own public address (origin checks, the sitemap). Locally always HTTPS on port 3001 (Document 7, section 17.1).
PUBLIC_SITE_URL=https://localhost:3001

# Header in which the hosting's front door gives the customer's address, for example x-forwarded-for. Leave empty
# locally. In staging and production set it for the host, and run the backend with TRUST_PROXY=true, so its
# per-address limits count each customer, not this server (Document 3, section 3; Document 4, section 4).
CLIENT_ADDRESS_HEADER=

# The public photo host (Document 3, D3-04). Pages may load images only from here.
# Locally this is Garage's website endpoint for the public bucket.
IMAGE_HOST=http://marketplace-public.web.localhost:9002

# Signs the pending-add and after-login cookies (D4-07). At least 32 characters. Make your own: openssl rand -hex 32.
# Never commit a real one.
COOKIE_SECRET=change-me-change-me-change-me-change-me-change-me-0123
