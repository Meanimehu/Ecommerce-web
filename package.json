{
  "name": "dhaaga-web",
  "version": "0.0.1",
  "private": true,
  "description": "Dhaaga web frontend: storefront, Vendor area and Admin area",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3001 --experimental-https",
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "start": "PORT=${PORT:-3001} HOSTNAME=${BIND_HOST:-127.0.0.1} node --env-file-if-exists=.env.local .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:e2e": "playwright test",
    "gen:types": "tsx scripts/gen-types.ts",
    "check:types": "tsx scripts/gen-types.ts --check",
    "check:types:live": "tsx scripts/gen-types.ts --check --live",
    "check:messages": "tsx scripts/check-messages.ts",
    "check": "npm run lint && npm run typecheck && npm run check:messages && npm run check:types && npm test",
    "gen:error-codes": "tsx scripts/gen-error-codes.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.5",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
