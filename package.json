{
  "name": "dhaaga-web",
  "version": "0.0.1",
  "private": true,
  "description": "Dhaaga web frontend: storefront, Vendor area and Admin area",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "start": "PORT=${PORT:-3001} HOSTNAME=${BIND_HOST:-127.0.0.1} node --env-file-if-exists=.env.local .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:store": "vitest run --project store",
    "test:e2e": "playwright test",
    "gen:types": "tsx scripts/gen-types.ts",
    "check:types": "tsx scripts/gen-types.ts --check",
    "check:types:live": "tsx scripts/gen-types.ts --check --live",
    "check:messages": "tsx scripts/check-messages.ts",
    "store:migrate": "tsx --env-file-if-exists=.env.local scripts/store-migrate.ts",
    "store:check": "tsx --env-file-if-exists=.env.local scripts/store-check.ts",
    "store:new-generation": "tsx --env-file-if-exists=.env.local scripts/store-new-generation.ts",
    "check": "npm run lint && npm run typecheck && npm run check:messages && npm run check:types && npm test"
  },
  "dependencies": {
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
